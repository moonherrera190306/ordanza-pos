# Postgres (Neon en producción). Usa la cadena "pooled" para la app.
DATABASE_URL="postgresql://usuario:password@host/ordanza_pos?sslmode=require"
# Secreto para firmar sesiones. Genera uno con: openssl rand -base64 32
AUTH_SECRET="cambia-esto-por-un-secreto-largo"
# Correos del personal de Ordanza con acceso al panel /ordanza (separados por coma)
SUPERADMIN_EMAILS="hola@ordanza.mx"
