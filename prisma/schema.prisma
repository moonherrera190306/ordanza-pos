// Ordanza POS — esquema multi-tenant.
// Regla: TODA consulta filtra por tenantId. La existencia de un producto
// NO se guarda en un campo: es la suma de sus Movimientos (libro de inventario).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  ADMIN
  CAJERO
  ALMACEN
}

enum TurnoEstado {
  ABIERTO
  CERRADO
}

enum MovTipo {
  INICIAL
  ENTRADA
  SALIDA
  AJUSTE
  VENTA
  CANCELACION
  DEVOLUCION
  COMPRA
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
  CREDITO
}

enum MovCajaTipo {
  ENTRADA
  RETIRO
}

enum MovClienteTipo {
  CARGO
  ABONO
}

enum VentaEstado {
  PAGADA
  CANCELADA
}

enum CitaEstado {
  PENDIENTE
  HECHA
  CANCELADA
}

model Tenant {
  id               String   @id @default(cuid())
  slug             String   @unique
  nombre           String
  rfc              String?
  direccion        String?
  telefono         String?
  piePagina        String   @default("¡Gracias por su compra!")
  anchoTicket      Int      @default(58)
  ivaPct           Decimal  @default(16) @db.Decimal(5, 2)
  permitirSinStock Boolean  @default(false)
  zonaHoraria      String   @default("America/Mexico_City")
  activo           Boolean  @default(true)
  creado           DateTime @default(now())

  // Autorización con PIN de un administrador cuando el usuario es cajero
  autorizarDescuento  Boolean @default(true)
  autorizarRetiro     Boolean @default(true)
  autorizarDevolucion Boolean @default(true)

  // Licencia (la administra Ordanza desde /ordanza)
  plan         String    @default("Básico")
  maxCajas     Int       @default(2)
  pagadoHasta  DateTime?
  notasOrdanza String?
  // Modo local: clave de licencia firmada por Ordanza
  licenciaClave String?

  usuarios    Usuario[]
  cajas       Caja[]
  turnos      Turno[]
  categorias  Categoria[]
  productos   Producto[]
  movimientos Movimiento[]
  ventas      Venta[]
  citas       Cita[]
  bitacora    Bitacora[]
  clientes    Cliente[]
  movsCliente MovCliente[]
  movsCaja    MovCaja[]
  proveedores Proveedor[]
  compras     Compra[]
  devoluciones Devolucion[]
}

model Usuario {
  id               String    @id @default(cuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nombre           String
  email            String?   @unique
  passwordHash     String?
  pinHash          String
  rol              Rol       @default(CAJERO)
  activo           Boolean   @default(true)
  intentosFallidos Int       @default(0)
  bloqueadoHasta   DateTime?
  creado           DateTime  @default(now())

  @@index([tenantId])
}

model Caja {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nombre      String
  clave       String
  activa      Boolean @default(true)
  consecutivo Int     @default(0)

  turnos Turno[]
  ventas Venta[]

  @@unique([tenantId, clave])
}

model Turno {
  id           String      @id @default(cuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cajaId       String
  caja         Caja        @relation(fields: [cajaId], references: [id])
  estado       TurnoEstado @default(ABIERTO)
  abiertoPorId String
  abiertoPor   String
  abiertoEn    DateTime    @default(now())
  fondo        Decimal     @db.Decimal(12, 2)
  cerradoPorId String?
  cerradoPor   String?
  cerradoEn    DateTime?
  esperado     Decimal?    @db.Decimal(12, 2)
  contado      Decimal?    @db.Decimal(12, 2)
  diferencia   Decimal?    @db.Decimal(12, 2)
  nota         String?

  ventas   Venta[]
  movsCaja MovCaja[]

  @@index([tenantId, cajaId, estado])
}

model Categoria {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nombre    String
  productos Producto[]

  @@unique([tenantId, nombre])
}

model Producto {
  id          String     @id @default(cuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nombre      String
  codigo      String?
  sku         String?
  categoriaId String?
  categoria   Categoria? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  unidad      String     @default("pza")
  esServicio  Boolean    @default(false)
  precio      Decimal    @db.Decimal(12, 2)
  costo       Decimal    @default(0) @db.Decimal(12, 2)
  minimo      Decimal    @default(0) @db.Decimal(12, 3)
  proveedor   String?
  ubicacion   String?
  fotoUrl     String?
  activo      Boolean    @default(true)
  creado      DateTime   @default(now())
  actualizado DateTime   @updatedAt

  movimientos Movimiento[]
  items       VentaItem[]
  compraItems CompraItem[]

  @@unique([tenantId, codigo])
  @@index([tenantId, nombre])
}

model Movimiento {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productoId    String
  producto      Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  tipo          MovTipo
  // Con signo: + entra, − sale. Existencia = SUM(cantidad).
  cantidad      Decimal  @db.Decimal(12, 3)
  costoUnit     Decimal? @db.Decimal(12, 2)
  nota          String?
  usuarioId     String
  usuarioNombre String
  ventaId       String?
  compraId      String?
  devolucionId  String?
  creado        DateTime @default(now())

  @@index([tenantId, productoId])
  @@index([tenantId, creado])
}

model Venta {
  id               String      @id @default(cuid())
  tenantId         String
  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  folio            String
  // Llave de idempotencia generada por el cliente (para reintentos y modo offline)
  clientId         String      @unique
  cajaId           String
  caja             Caja        @relation(fields: [cajaId], references: [id])
  turnoId          String
  turno            Turno       @relation(fields: [turnoId], references: [id])
  usuarioId        String
  usuarioNombre    String
  cliente          String?
  clienteId        String?
  clienteRef       Cliente?    @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  autorizadoPor    String?
  subtotal         Decimal     @db.Decimal(12, 2)
  descuento        Decimal     @default(0) @db.Decimal(12, 2)
  iva              Decimal     @db.Decimal(12, 2)
  total            Decimal     @db.Decimal(12, 2)
  costo            Decimal     @db.Decimal(12, 2)
  metodo           MetodoPago
  recibido         Decimal     @db.Decimal(12, 2)
  cambio           Decimal     @db.Decimal(12, 2)
  estado           VentaEstado @default(PAGADA)
  canceladaPor     String?
  canceladaEn      DateTime?
  motivoCancelacion String?
  creado           DateTime    @default(now())

  items        VentaItem[]
  pagos        VentaPago[]
  devoluciones Devolucion[]

  @@unique([tenantId, folio])
  @@index([tenantId, creado])
  @@index([turnoId])
}

model VentaItem {
  id         String   @id @default(cuid())
  ventaId    String
  venta      Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id])
  nombre     String
  unidad     String
  precio     Decimal  @db.Decimal(12, 2)
  costo      Decimal  @db.Decimal(12, 2)
  cantidad   Decimal  @db.Decimal(12, 3)
  importe    Decimal  @db.Decimal(12, 2)
  devuelto   Decimal  @default(0) @db.Decimal(12, 3)
}

// Cómo se pagó una venta. Montos ya aplicados (el efectivo va sin el cambio).
model VentaPago {
  id      String     @id @default(cuid())
  ventaId String
  venta   Venta      @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  metodo  MetodoPago
  monto   Decimal    @db.Decimal(12, 2)

  @@index([ventaId])
}

model Cliente {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nombre        String
  telefono      String?
  email         String?
  rfc           String?
  // 0 = sin crédito
  limiteCredito Decimal  @default(0) @db.Decimal(12, 2)
  nota          String?
  activo        Boolean  @default(true)
  creado        DateTime @default(now())

  ventas Venta[]
  movs   MovCliente[]

  @@index([tenantId, nombre])
}

// Cuenta del cliente: CARGO = compra a crédito, ABONO = pago o devolución. Saldo = cargos − abonos.
model MovCliente {
  id            String         @id @default(cuid())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clienteId     String
  cliente       Cliente        @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  tipo          MovClienteTipo
  monto         Decimal        @db.Decimal(12, 2)
  metodo        MetodoPago?
  ventaId       String?
  turnoId       String?
  nota          String?
  usuarioId     String
  usuarioNombre String
  creado        DateTime       @default(now())

  @@index([tenantId, clienteId])
  @@index([turnoId])
}

// Entradas y retiros de efectivo de la caja durante un turno.
model MovCaja {
  id            String      @id @default(cuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  turnoId       String
  turno         Turno       @relation(fields: [turnoId], references: [id], onDelete: Cascade)
  tipo          MovCajaTipo
  monto         Decimal     @db.Decimal(12, 2)
  concepto      String
  compraId      String?
  usuarioId     String
  usuarioNombre String
  autorizadoPor String?
  creado        DateTime    @default(now())

  @@index([turnoId])
}

model Devolucion {
  id            String           @id @default(cuid())
  tenantId      String
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ventaId       String
  venta         Venta            @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  turnoId       String?
  total         Decimal          @db.Decimal(12, 2)
  // Cómo se regresó el dinero (CREDITO = abono a la cuenta del cliente)
  metodo        MetodoPago
  motivo        String
  usuarioId     String
  usuarioNombre String
  autorizadoPor String?
  creado        DateTime         @default(now())
  items         DevolucionItem[]

  @@index([tenantId, creado])
  @@index([turnoId])
}

model DevolucionItem {
  id           String     @id @default(cuid())
  devolucionId String
  devolucion   Devolucion @relation(fields: [devolucionId], references: [id], onDelete: Cascade)
  ventaItemId  String
  productoId   String
  nombre       String
  cantidad     Decimal    @db.Decimal(12, 3)
  importe      Decimal    @db.Decimal(12, 2)
}

model Proveedor {
  id       String   @id @default(cuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nombre   String
  contacto String?
  telefono String?
  email    String?
  rfc      String?
  nota     String?
  activo   Boolean  @default(true)
  creado   DateTime @default(now())
  compras  Compra[]

  @@unique([tenantId, nombre])
}

model Compra {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  proveedorId   String?
  proveedor     Proveedor?   @relation(fields: [proveedorId], references: [id], onDelete: SetNull)
  factura       String?
  total         Decimal      @db.Decimal(12, 2)
  nota          String?
  pagadoDeCaja  Boolean      @default(false)
  usuarioId     String
  usuarioNombre String
  creado        DateTime     @default(now())
  items         CompraItem[]

  @@index([tenantId, creado])
}

model CompraItem {
  id         String   @id @default(cuid())
  compraId   String
  compra     Compra   @relation(fields: [compraId], references: [id], onDelete: Cascade)
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id])
  nombre     String
  cantidad   Decimal  @db.Decimal(12, 3)
  costo      Decimal  @db.Decimal(12, 2)
  importe    Decimal  @db.Decimal(12, 2)
}

model Cita {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  titulo    String
  fecha     String // YYYY-MM-DD en la zona del negocio
  hora      String? // HH:mm
  cliente   String?
  telefono  String?
  nota      String?
  estado    CitaEstado @default(PENDIENTE)
  creadoPor String
  creado    DateTime   @default(now())

  @@index([tenantId, fecha])
}

model Bitacora {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usuarioId     String?
  usuarioNombre String
  modulo        String
  accion        String
  detalle       String?
  creado        DateTime @default(now())

  @@index([tenantId, creado])
}
